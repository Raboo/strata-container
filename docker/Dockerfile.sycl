# syntax=docker/dockerfile:1
#
# Strata for Intel Arc through the experimental SYCL port (sycl/, docs/INTEL_ARC.md).
# Upstream has no ready-made Intel image; this follows its documented Docker
# build (the same oneAPI/Level Zero base its setup uses) and its JIT build, so
# the image runs on Alchemist and Battlemage. AOT for one device can be enabled
# with --build-arg SYCL_AOT=bmg-g31 (Arc Pro B70) or bmg-g21 (B580/B570/Pro B60).
#
# The port's setup normally runs the engine in a nested `strata-sycl-dev`
# container. Here the engine is inside the image, so sycl/serve/strata-sycl.sh
# is replaced with a direct exec and the data lives under /work (the path
# sycl_path() writes into the config).
#
# Run (host needs the xe/i915 driver and Intel compute runtime; /dev/dri):
#   docker run --rm --device /dev/dri -p 8080:8080 \
#     -v strata-data:/work/data -e MODEL=IQ2_XS strata-sycl

FROM ghcr.io/snailium/llama.cpp-sycl-intel-b70/llama-sycl-b70:stable

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8 \
    ONEAPI_DEVICE_SELECTOR=level_zero:0 \
    STRATA_SYCL_ROOT=/work \
    STRATA_DATA=/work/data

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git libatomic1 libgomp1 \
        ninja-build python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

# /work/strata because sycl_path() maps every model path to /work/...
WORKDIR /work/strata
COPY . .

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh

# The pinned llama.cpp the rest of the image uses (sycl/CMakeLists.txt would
# otherwise fetch its own copy during configure).
RUN .venv/bin/python -c 'import setup; print(setup.get_llama_cpp())'

ARG SYCL_AOT=""

SHELL ["/bin/bash", "-lc"]
RUN source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1; \
    .venv/bin/cmake -S sycl -B build-sycl -G Ninja \
        -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx \
        -DSTRATA_SYCL_AOT="${SYCL_AOT}" \
        -DSTRATA_SYCL_PARITY=OFF \
        -DSTRATA_GGML_DIR=/work/strata/third_party/llama.cpp \
    && .venv/bin/cmake --build build-sycl --target strata -j 4
SHELL ["/bin/sh", "-c"]

# Keep the binary where setup_intel.py looks for it, drop the build tree.
RUN mv build-sycl/strata /tmp/strata-sycl \
    && rm -rf build-sycl \
    && mkdir build-sycl \
    && mv /tmp/strata-sycl build-sycl/strata

# The port's host wrapper would start a nested strata-sycl-dev container.
# Inside this image the engine runs directly.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# In this image the SYCL engine runs directly; there is no nested Docker.' \
      'exec /work/strata/build-sycl/strata "$@"' \
      > sycl/serve/strata-sycl.sh \
    && chmod +x sycl/serve/strata-sycl.sh

RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'cd /work/strata' \
      '' \
      'DATA="${STRATA_DATA:-/work/data}"' \
      'FAMILY="${FAMILY:-qwen}"' \
      'MODEL="${MODEL:-IQ2_XS}"' \
      'CONTEXT="${CONTEXT:-32768}"' \
      'HOST="${HOST:-0.0.0.0}"' \
      'PORT="${PORT:-8080}"' \
      'API_KEY="${API_KEY:-}"' \
      'DRAFT_VOCAB="${DRAFT_VOCAB:-}"' \
      '' \
      '# The port keeps experts in VRAM and streams the rest from the GGUF.' \
      'export STRATA_SYCL_ROOT=/work STRATA_VERIFY_DEVICE_PLAN=1 STRATA_VERIFY_NO_HOST=1 STRATA_STAGER_THREADS=12' \
      '' \
      'mkdir -p "$DATA"' \
      'case "$FAMILY" in qwen) prefix="" ;; *) prefix="${FAMILY}-" ;; esac' \
      'tag="${prefix}$(printf "%s" "$MODEL" | tr "A-Z" "a-z")"' \
      'cfg="$DATA/config/strata-$tag.json"' \
      'link="/work/strata/strata-$tag.json"' \
      '' \
      'if [ "${REINSTALL:-0}" = "1" ] || [ ! -f "$cfg" ]; then' \
      '  echo "Setting up $tag (the SYCL engine is already built in this image)."' \
      '  set -- --backend sycl --setup --yes \' \
      '      --family "$FAMILY" --model "$MODEL" --context "$CONTEXT" \' \
      '      --data-dir "$DATA" --host "$HOST" --port "$PORT" --api-key "$API_KEY" --no-start' \
      '  [ -n "$DRAFT_VOCAB" ] && set -- "$@" --draft-vocab "$DRAFT_VOCAB"' \
      '  .venv/bin/python setup.py "$@"' \
      '  [ -f "/work/strata/strata-$tag.json" ] && cp -f "/work/strata/strata-$tag.json" "$cfg"' \
      'fi' \
      'ln -sfn "$cfg" "$link"' \
      '' \
      '# Wrapper config overrides: PREFILL, CONVERSATION_CACHE_MIB, FIT_MAX_TOKENS, SAMPLING_*.' \
      '.venv/bin/python /work/strata/strata-env-config.py "$cfg"' \
      '' \
      'set -- --backend sycl --port "$PORT"' \
      '[ -n "$DRAFT_VOCAB" ] && set -- "$@" --draft-vocab "$DRAFT_VOCAB"' \
      'exec .venv/bin/python setup.py "$@"' \
      > /usr/local/bin/strata-entrypoint \
    && chmod +x /usr/local/bin/strata-entrypoint

VOLUME ["/work/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/strata-entrypoint"]
